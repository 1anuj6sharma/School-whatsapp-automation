# =====================================================================
# META WHATSAPP CLOUD API CONFIGURATION
# =====================================================================
WHATSAPP_PHONE_NUMBER_ID=phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=account_id
WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_access_token_here
WHATSAPP_API_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=verify_token
WHATSAPP_MAX_CONCURRENCY=5

META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# =====================================================================
# DATABASE CONNECTION CONFIGURATION (POSTGRESQL / MSSQL / SQLITE)
# =====================================================================
# Database Type: postgres | mssql | sqlite
DB_TYPE=postgres

# Database Server Host / IP (Use 'postgres' for docker-compose or 'localhost' / IP for external server)
DB_HOST=postgres

# Database Port (Default PostgreSQL: 5432, MSSQL: 1433)
DB_PORT=5432

# Database Credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=school_whatsapp

# Django Secret Key & Debug
DJANGO_SECRET_KEY=django
DJANGO_DEBUG=True
