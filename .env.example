# ==============================================================================
# SCHOOL WHATSAPP AUTOMATION - DOCKER & LOCAL CONFIGURATION
# ==============================================================================

# 1. META WHATSAPP CLOUD API SETTINGS
# Get your "Phone number ID" from: Meta Developers -> WhatsApp -> API Setup (Step 1: Send and receive messages)
WHATSAPP_PHONE_NUMBER_ID=your_actual_phone_number_id_here

# Paste your Meta Access Token here:
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here

# Meta Graph API Version
WHATSAPP_API_VERSION=v26.0

# Custom verification token for Meta Webhook setup
WHATSAPP_VERIFY_TOKEN=school_whatsapp_verify_token_secret_123

# Bulk sending concurrency limit
WHATSAPP_MAX_CONCURRENCY=5

# 2. DATABASE SETTINGS (Zero-config SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./school_whatsapp.db

# 3. RECIPIENT PHONE NUMBERS CONFIGURATION
# Format: [Country Code] + [Phone Number] with NO plus (+), NO spaces, NO dashes.
#
# Examples:
# For India (+91) with number 9876543210  -> 919876543210
# For US (+1) with number 555-123-4567    -> 15551234567
# For UK (+44) with number 7123-456789    -> 447123456789

TEST_RECIPIENT_1=919876543210
TEST_RECIPIENT_2=919876543211

# You can also add more recipient numbers separated by commas:
# RECIPIENT_NUMBERS=919876543210,919876543211,919876543212
