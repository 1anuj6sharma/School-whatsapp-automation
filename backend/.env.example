# =====================================================================
# META WHATSAPP CLOUD API CONFIGURATION
# =====================================================================
WHATSAPP_PHONE_NUMBER_ID=1393372873849630
WHATSAPP_BUSINESS_ACCOUNT_ID=1086203377344807
WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_access_token_here
WHATSAPP_API_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=school_whatsapp_verify_token_secret_123
WHATSAPP_MAX_CONCURRENCY=5

# =====================================================================
# DATABASE CONNECTION CONFIGURATION (INDIVIDUAL FIELDS)
# =====================================================================
# Database Type: mssql | postgres | sqlite
DB_TYPE=mssql

# Database Server Host / IP (e.g. localhost, 127.0.0.1, or SERVER_NAME\SQLEXPRESS)
DB_HOST=localhost

# Database Port (Default for MSSQL: 1433, PostgreSQL: 5432)
DB_PORT=1433

# Database User
DB_USER=sa

# Database Password
DB_PASSWORD=YourStrongPassword123

# Database Name
DB_NAME=SchoolWhatsApp

# Optional SQL Server ODBC Driver Name (Default: ODBC Driver 17 for SQL Server)
DB_DRIVER=ODBC Driver 17 for SQL Server

# =====================================================================
# DIRECT DATABASE URL (OPTIONAL OVERRIDE)
# =====================================================================
# If DATABASE_URL is set, it will override the individual DB_* fields above.
#
# Microsoft SQL Server (ODBC async):
# DATABASE_URL=mssql+aioodbc://sa:YourStrongPassword123@localhost:1433/SchoolWhatsApp?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
#
# Microsoft SQL Server (pymssql):
# DATABASE_URL=mssql+pymssql://sa:YourStrongPassword123@localhost:1433/SchoolWhatsApp
#
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_whatsapp
#
# SQLite (Zero configuration local database):
# DATABASE_URL=sqlite+aiosqlite:///./school_whatsapp.db
